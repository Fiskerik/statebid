# Cloudflare Turnstile (optional locally; required before public launch).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=

# Operator-only platform authentication allowlist (comma-separated).
ADMIN_USER_IDS=
ADMIN_EMAIL=

# Required before live payments.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=SE
SUPPORT_EMAIL=support@statebid.lol
PRIVACY_RETENTION_DAYS=30
