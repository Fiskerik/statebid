# Public Vercel deployment URL, e.g. https://us-statebid.vercel.app
SITE_URL=
# Preview-only visual fixture. Keep false/unset in Production.
DEMO_DATA=false

# Turso/libSQL database. Required for persistent rankings and bidding.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob. Create a private Blob store in the Vercel project to populate this.
BLOB_READ_WRITE_TOKEN=

# Stripe test mode only until legal, operator, and tax configuration is complete.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false

# Cloudflare Turnstile (optional locally; required before public launch).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=

# Operator-only authentication. Password must be 12+ characters; session secret 32+.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required before live payments.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=SE
SUPPORT_EMAIL=support@statebid.lol
PRIVACY_RETENTION_DAYS=30
